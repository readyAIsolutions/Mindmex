class HeyGenProvider(MediaProvider):
    name = "HeyGen"
    env_var = "HEYGEN_API_KEY"
    base = "https://api.heygen.com/v1"

    def _headers(self):
        return {"X-Api-Key": self.api_key, "Content-Type": "application/json"}

    def gen_avatar_video(self, script: str, avatar_id: str | None = None,
                         voice_id: str | None = None, background: str | None = None,
                         callback_url: str | None = None) -> AssetResult:
        if self.mock_mode:
            return self._mock_asset("video")
        payload = {
            "video_inputs": {
                "character": {"type": "text", "input_text": script,
                              "avatar_id": avatar_id or "default_narrator"},
                "voice": {"type": "text", "input_text": script,
                          "voice_id": voice_id or "default_voice"},
            }
        }
        if background:
            payload["video_inputs"]["background"] = {"type": "color", "value": background}
        data = self._post_json(f"{self.base}/videos", payload)
        vid = data.get("data", {}).get("video_id")
        return self._poll_video(vid)

    def _poll_video(self, vid, max_waits=15, delay=6.0) -> AssetResult:
        for _ in range(max_waits):
            d = self._get_json(f"{self.base}/videos/{vid}")
            status = d.get("data", {}).get("status", "").lower()
            if status == "completed":
                url = d.get("data", {}).get("video_url", [""])
                return AssetResult(kind="video", id=vid, status="ready",
                                   urls=[url] if url else [], provider=self.name)
            if status in ("failed", "cancel"):
                return AssetResult(kind="video", id=vid, status="failed", provider=self.name)
            time.sleep(delay)
        return AssetResult(kind="video", id=vid, status="processing", provider=self.name)

# ---------------------------------------------------------------------------
# Registry
# ---------------------------------------------------------------------------

class MediaRegistry:
    """Registry of providers keyed by capability. Returns mock on missing keys."""

    FALLBACKS = {
        "scene_video": ["runway", "pika", "luma"],
        "talking_video": ["heygen"],
        "image": ["pika", "runway", "stability"],
        "audio": ["pika"],
    }

    def __init__(self):
        self._providers = {
            "runway": RunwayProvider(),
            "luma": LumaProvider(),
            "pika": PikaProvider(),
            "heygen": HeyGenProvider(),
        }

    def get(self, name: str) -> MediaProvider | None:
        return self._providers.get(name)

    def best_for(self, capability: str) -> MediaProvider | None:
        for pname in self.FALLBACKS.get(capability, []):
            p = self._providers.get(pname)
            if p and not p.mock_mode:
                return p
        # No live provider -> return the first provider in mock mode
        for pname in self.FALLBACKS.get(capability, []):
            p = self._providers.get(pname)
            if p:
                return p
        return None

    def status(self) -> dict:
        return {name: "live" if not p.mock_mode else "mock" for name, p in self._providers.items()}

def build_registry() -> MediaRegistry:
    return MediaRegistry()

