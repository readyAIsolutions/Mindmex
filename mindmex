#!/usr/bin/env python3
"""MindMex YouTube Publisher — REAL OAuth2 upload to the YouTube Data API.

Uploads the assembled episode video to YouTube with title, description, tags,
thumbnails, privacy status, and (optionally) scheduled publishing — the real
OAuth flow, not a stub. Gracefully degrades to deterministic MOCK mode when the
Google libraries or credentials are not present, so the pipeline stays runnable.

REAL SETUP (one time):
   1. Create OAuth2 Desktop credentials at Google Cloud Console:
        APIs & Services > Enabled APIs > enable "YouTube Data API v3"
        Credentials > Create > OAuth client ID > "Desktop app"
      Download as client_secret.json and save to MindMex/credentials/.
   2. Install the Google client libs (the project's venv):
        python3 -m venv .venv && source .venv/bin/activate
        pip install --upgrade google-api-python-client google-auth-oauthlib google-auth-httplib2
   3. Run the authorize helper once to mint a refresh token (opens a browser):
        python3 youtube_uploader.py --auth-oauth
      This stores credentials/token.json (refresh token) — do NOT commit it.

ENV:
    YOUTUBE_CLIENT_SECRET_FILE   default: credentials/client_secret.json
    YOUTUBE_TOKEN_FILE           default: credentials/token.json
    YOUTUBE_API_KEY              read-only fallback (video lookup), not for upload

UPLOAD (chrome shell, returns a videos.insert resource with resumable upload):
    uploader.upload_video(video_path, title, description, tags=...,
                          thumbnail_path=..., privacy_status="private",
                          publish_at="2027-01-01T12:00:00Z")
    uploader.upload_thumbnail(video_id, thumbnail_path)
    uploader.create_playlist(title, description, video_ids)
"""

import json
import os
import sys
import time
from pathlib import Path
from typing import Any, Optional

# The Google API stack is optional. If absent, we are in mock mode.
try:
    from google.oauth2.credentials import Credentials
    from google_auth_oauthlib.flow import InstalledAppFlow
    from google.auth.transport.requests import Request
    from googleapiclient.discovery import build
    from googleapiclient.http import MediaFileUpload
    _GOOGLE_OK = True
except ImportError:
    _GOOGLE_OK = False

DEFAULT_DIR = Path("/home/nova/Downloads/MindMex/credentials")

SCOPES = [
    "https://www.googleapis.com/auth/youtube.upload",
    "https://www.googleapis.com/auth/youtube",
    "https://www.googleapis.com/auth/youtube.force-ssl",
]

# YouTube video category id codes
CATEGORY_IDS = {
    "education": "27",
    "entertainment": "24",
    "film": "1",
    "people": "22",
}

PRIVACY = {"public", "unlisted", "private"}

class YouTubeUploadError(Exception):
    pass

class YouTubeUploader:
    """Publishes MindMex episode videos to YouTube via the Data API v3 (OAuth)."""

    def __init__(self, mock_mode: bool | None = None, credential_dir: str | None = None):
        self.cred_dir = Path(credential_dir or os.getenv("YOUTUBE_CLIENT_SECRET_FILE", str(DEFAULT_DIR))).parent
        self.client_secret = self.cred_dir / "client_secret.json"
        self.token_path = self.cred_dir / "token.json"
        # We are mock when google libs are missing OR no saved credentials.
        self.mock_mode = self._decide_mock(mock_mode)
        self.service = None if self.mock_mode else self._build_service()

    # ------------------------------------------------------------------
    # Mode decisions / auth
    # ------------------------------------------------------------------
    def _decide_mock(self, override: bool | None) -> bool:
        if override is not None:
            return override
        if not _GOOGLE_OK:
            return True
        return not (self.client_secret.exists() and self.token_path.exists())

    def _build_service(self):
        creds = None
        if self.token_path.exists():
            creds = Credentials.from_authorized_user_file(str(self.token_path), SCOPES)
        if creds and creds.expired and creds.refresh_token:
            creds.refresh(Request())
            self._save_token(creds)
        if creds and creds.valid:
            return build("youtube", "v3", credentials=creds)
        raise YouTubeUploadError(
            "No valid YouTube credentials. Run: python3 youtube_uploader.py --auth-oauth  (once)"
        )

    def _save_token(self, creds) -> None:
        self.token_path.parent.mkdir(parents=True, exist_ok=True)
        self.token_path.write_text(creds.to_json())

    def authorize_oauth(self) -> str:
        """One-time OAuth2 browser flow to mint a refresh token."""
        if not _GOOGLE_OK:
            return "Google libraries not installed. Create .venv and: pip install google-api-python-client google-auth-oauthlib"
        if not self.client_secret.exists():
            return (f"Missing {self.client_secret}\n"
                    "Put your OAuth Desktop client_secret.json here (from Google Cloud Console, "
                    "with YouTube Data API v3 enabled).")
        flow = InstalledAppFlow.from_client_secrets_file(str(self.client_secret), SCOPES)
        creds = flow.run_local_server(port=0)
        self._save_token(creds)
        return f"OAuth complete. Token saved to {self.token_path}. You can now upload."

    # ------------------------------------------------------------------
    # Upload
    # ------------------------------------------------------------------
    def upload_video(
        self,
        video_path: str,
        title: str,
        description: str,
        tags: Optional[list] = None,
        category_id: str = "27",
        privacy_status: str = "private",
        publish_at: Optional[str] = None,
        thumbnail_path: Optional[str] = None,
    ) -> str:
        if privacy_status not in PRIVACY:
            raise YouTubeUploadError(f"invalid privacy_status {privacy_status}")

        if self.mock_mode:
            # A real (no-)op that returns a plausible fake id, like a stub but honest.
            import hashlib
            fake = hashlib.md5((title + description).encode()).hexdigest()[:11]
            print(f"  [MOCK] YouTube upload: '{title}' -> https://youtu.be/{fake}  (add OAuth creds to publish for real)")
            return fake

        apath = Path(video_path)
        if not apath.exists():
            raise YouTubeUploadError(f"video not found: {apath}")

        # privacy/status: private + publishAt means "scheduled" == public later
        status = None
        if publish_at:
            status = {"privacyStatus": "public", "publishAt": publish_at}
            privacy_status = "private"
        else:
            status = {"privacyStatus": privacy_status}

        body = {
            "snippet": {
                "title": title[:100],
                "description": description,
                "tags": (tags or [])[:500],
                "categoryId": category_id,
            },
            "status": status,
        }
        media = MediaFileUpload(str(apath), resumable=True, chunksize=5 * 1024 * 1024)
        req = self.service.videos().insert(part="snippet,status", body=body, media_body=media)
        resp = req.execute()
        vid = resp.get("id")

        if thumbnail_path and Path(thumbnail_path).exists():
            self.upload_thumbnail(vid, thumbnail_path)
        return vid

    def upload_thumbnail(self, video_id: str, thumbnail_path: str) -> str:
        if self.mock_mode:
            print(f"  [MOCK] thumbnail applied to {video_id}")
            return f"thumb-{video_id}"
        if not Path(thumbnail_path).exists():
            raise YouTubeUploadError(f"thumbnail not found: {thumbnail_path}")
        media = MediaFileUpload(thumbnail_path)
        req = self.service.thumbnails().set(videoId=video_id, media_body=media)
        req.execute()
        return f"thumb-{video_id}"

    def create_playlist(self, title: str, description: str, video_ids: list) -> str:
        if self.mock_mode:
            return f"playlist-{abs(hash(title)) % 99999}"
        body = {"snippet": {"title": title[:100], "description": description}}
        pl = self.service.playlists().insert(part="snippet,status", body=body).execute()
        pid = pl.get("id")
        for vid in video_ids:
            self.service.playlistItems().insert(
                part="snippet",
                body={"snippet": {"playlistId": pid, "resourceId": {"kind": "youtube#video", "videoId": vid}}},
            ).execute()
        return pid

    def export_series(self, series_slug: str) -> list:
        """Publish every approved episode in a series as one upload (real or mock)."""
        orch = MindMexPipelineOrchestrator(mock_mode=self.mock_mode)
        master = orch.output_root / "manifests" / f"{series_slug}-master.json"
        if not master.exists():
            print(f"[{self.mock_mode and 'MOCK' or 'LIVE'}] no master manifest for '{series_slug}'")
            return []
        data = json.loads(master.read_text())
        out = []
        for i, ep in enumerate(data.get("episodes", []), start=1):
            vpath = ep.get("video_path")
            if not vpath or not os.path.exists(vpath):
                continue
            title = ep.get("plan", {}).get("seo_title") or ep.get("plan", {}).get("title") or f"{series_slug} EP{i}"
            desc = ep.get("plan", {}).get("seo_description", "")
            v = self.upload_video(vpath, title, desc, tags=[series_slug])
            out.append(v)
            print(f"  -> {v} : {title}")
        return out

    def status(self) -> str:
        return "live (OAuth ready)" if not self.mock_mode else "mock (add Google creds to go live)"

def _cli():
    import argparse
    ap = argparse.ArgumentParser(prog="youtube_uploader", description="MindMex YouTube publisher")
    ap.add_argument("--auth-oauth", action="store_true", help="One-time OAuth2 browser authorization")
    ap.add_argument("--video", help="path to mp4")
    ap.add_argument("--title", default="MindMex episode")
    ap.add_argument("--description", default="")
    ap.add_argument("--tags", nargs="*", default=[])
    ap.add_argument("--category", default="27")
    ap.add_argument("--privacy", default="private", choices=sorted(PRIVACY))
    ap.add_argument("--thumbnail", help="path to thumbnail image")
    ap.add_argument("--publish-at", help="ISO-8601 publish time")
    ap.add_argument("--status", action="store_true", help="print mode")
    args = ap.parse_args()

    u = YouTubeUploader()

    if args.status:
        print(u.status())
    elif args.auth_oauth:
        print(u.authorize_oauth())
    elif args.video:
        vid = u.upload_video(args.video, args.title, args.description,
                             tags=args.tags, category_id=args.category,
                             privacy_status=args.privacy, publish_at=args.publish_at,
                             thumbnail_path=args.thumbnail)
        print(f"uploaded: {vid}")
    else:
        ap.print_help()

