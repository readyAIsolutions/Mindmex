#!/usr/bin/env python3
"""
MindMex Empire Builder — original superhero universe with HUMAN-IN-THE-LOOP.

Models an original "media empire" (a new Marvel-style universe) as a set of
interlocking entities. EVERY creative decision is produced as a DRAFT and gated
on a human (the showrunner / LO) approving it before it is locked for production.

Entity types and their approval lifecycle:
    Universe  : the shared world, tone, age-rating strategy (kids + adults)
    Hero      : original character with powers, weakness, design, story hooks
    Villain   : original nemesis with scheme, power, arc
    Saga      : multi-season storyline (the "Phase" plan) tying heroes together
    Voice     : the voice chosen for a character (oversee voice choices)

Lifecycle (state machine):
    draft  -->  review  -->  approved          (locked, production can consume it)
                     -->  rejected + note     (back to draft after edits)

Persistence: a working dir of JSON files (default output/empire/) so decisions
and approvals survive restarts. This is the source of truth for which stories,
characters and voices are cleared to be produced.

Usage (see also CLI):
    e = Empire()
    h = e.add_hero("Nova Prime", powers=[...], ...)   # -> draft
    e.submit_hero(h.id)                                # -> review
    e.approve_hero(h.id, by="LO")                      # -> approved
    e.reject_hero(h.id, by="LO", note="too dark")      # -> rejected

Guarantees:
    - Nothing is ever "approved" out of the box; every entity starts in draft.
    - Production code (orchestrator/mcp) refuses to consume a hero/villain/voice
      until status == approved.
"""

import json
import os
import re
import uuid
from dataclasses import dataclass, field, asdict
from datetime import datetime, timezone
from pathlib import Path
from typing import Any, Optional

# ---------------------------------------------------------------------------
# Approval states
# ---------------------------------------------------------------------------

DRAFT, REVIEW, APPROVED, REJECTED = "draft", "review", "approved", "rejected"
VALID_STATES = {DRAFT, REVIEW, APPROVED, REJECTED}

class ApprovalError(Exception):
    pass

# ---------------------------------------------------------------------------
# Entities
# ---------------------------------------------------------------------------

@dataclass
class BaseEntity:
    id: str = field(default_factory=lambda: uuid.uuid4().hex[:10])
    status: str = DRAFT
    created_at: str = field(default_factory=lambda: datetime.now(timezone.utc).isoformat())
    updated_at: str = field(default_factory=lambda: datetime.now(timezone.utc).isoformat())
    history: list = field(default_factory=list)   # audit trail of approvals/edits
    approved_by: Optional[str] = None
    note: str = ""

    def _touch(self):
        self.updated_at = datetime.now(timezone.utc).isoformat()

    def _transit(self, to: str, by: str, note: str = ""):
        if to not in VALID_STATES:
            raise ApprovalError(f"invalid state {to}")
        if to == APPROVED and self.status != REVIEW:
            raise ApprovalError(f"must be in REVIEW before approval (current={self.status})")
        if to == REVIEW and self.status != DRAFT:
            raise ApprovalError(f"can only submit DRAFT for review, current={self.status}")
        if self.status == APPROVED and to != APPROVED:
            raise ApprovalError(f"approved entities cannot be reverted ({self.id})")
        self.history.append({
            "at": datetime.now(timezone.utc).isoformat(),
            "from": self.status, "to": to, "by": by, "note": note,
        })
        self.status = to
        self.approved_by = by if to == APPROVED else self.approved_by
        self.note = note if note else self.note
        self._touch()

    def submit(self, by: str, note: str = ""):
        self._transit(REVIEW, by, note)

    def approve(self, by: str, note: str = ""):
        self._transit(APPROVED, by, note)

    def reject(self, by: str, note: str = ""):
        self._transit(REJECTED, by, note)

    def to_dict(self) -> dict:
        return asdict(self)

@dataclass
class Hero(BaseEntity):
    name: str = ""
    codename: str = ""
    powers: list = field(default_factory=list)
    weakness: str = ""
    origin: str = ""
    design: str = ""            # image/thumbnail prompt seed
    voice_id: str = ""          # ElevenLabs/OSS voice for this character
    voice_note: str = ""        # human note on the voice choice
    age_rating: str = "G"
    personality: str = ""
    flags: list = field(default_factory=list)   # e.g. ["kids_favorite","adult_depth"]
    hooks: list = field(default_factory=list)   # story hooks

@dataclass
class Villain(BaseEntity):
    name: str = ""
    codename: str = ""
    power: str = ""
    scheme: str = ""
    arc: str = ""            # how the villain grows across seasons
    voice_id: str = ""
    voice_note: str = ""
    threat_level: str = "street"   # street | state | cosmic
    design: str = ""

@dataclass
class Saga(BaseEntity):
    title: str = ""
    phase: str = "Phase 1"
    blurb: str = ""
    beats: list = field(default_factory=list)   # storyline beats
    hero_ids: list = field(default_factory=list)
    villain_ids: list = field(default_factory=list)
    age_rating: str = "G"

@dataclass
class Universe(BaseEntity):
    name: str = ""
    tagline: str = ""
    core_theme: str = ""
    tone: str = ""
    kids_strategy: str = ""
    adults_strategy: str = ""
    hero_ids: list = field(default_factory=list)
    villain_ids: list = field(default_factory=list)
    saga_ids: list = field(default_factory=list)

# ---------------------------------------------------------------------------
# Empire store
# ---------------------------------------------------------------------------

class Empire:
    """The human-in-the-loop store + state machine for an original universe."""

    def __init__(self, root: str | None = None, universe_name: str = "New Empire"):
        self.root = Path(root or os.getenv("MINDMEX_EMPIRE_DIR", "/home/nova/Downloads/MindMex/output/empire"))
        self.root.mkdir(parents=True, exist_ok=True)
        self.data_path = self.root / f"{self._slug(universe_name)}.json"
        self.universe_name = universe_name
        self.data: dict = self._load()
        if "heroes" not in self.data:
            self.data["heroes"] = {}
        if "villains" not in self.data:
            self.data["villains"] = {}
        if "sagas" not in self.data:
            self.data["sagas"] = {}
        if "voices" not in self.data:
            self.data["voices"] = {}

    # -- persistence ---------------------------------------------------------
    @staticmethod
    def _slug(t: str) -> str:
        return re.sub(r"[^a-z0-9]+", "-", t.lower()).strip("-") or "empire"

    def _save(self):
        self.data_path.parent.mkdir(parents=True, exist_ok=True)
        self.data_path.write_text(json.dumps(self.data, indent=2))

    def _load(self) -> dict:
        if self.data_path.exists():
            try:
                return json.loads(self.data_path.read_text())
            except Exception:
                return {}
        return {}

    # -- heroes --------------------------------------------------------------
    def add_hero(self, name, codename, powers, weakness="", origin="",
                 design="", voice_id="", personality="", age_rating="G",
                 flags=None, hooks=None) -> Hero:
        hero = Hero(
            name=name, codename=codename, powers=powers, weakness=weakness,
            origin=origin, design=design, voice_id=voice_id,
            personality=personality, age_rating=age_rating,
            flags=flags or [], hooks=hooks or [],
        )
        self.data["heroes"][hero.id] = hero.to_dict()
        self._save()
        return hero

    def get_hero(self, hid: str) -> Hero:
        d = self.data["heroes"].get(hid)
        if not d:
            raise ApprovalError(f"hero {hid} not found")
        return Hero(**d)

    def submit_hero(self, hid: str, by: str = "agent", note: str = ""):
        h = self.get_hero(hid); h.submit(by, note)
        self._put_hero(h)

    def approve_hero(self, hid: str, by: str, note: str = ""):
        h = self.get_hero(hid); h.approve(by, note)
        self._put_hero(h)

    def reject_hero(self, hid: str, by: str, note: str = ""):
        h = self.get_hero(hid); h.reject(by, note)
        self._put_hero(h)

    def _put_hero(self, h: Hero):
        self.data["heroes"][h.id] = h.to_dict(); self._save()

    def heroes(self, status: str | None = None) -> list[Hero]:
        out = [Hero(**d) for d in self.data["heroes"].values()]
        if status:
            out = [h for h in out if h.status == status]
        return sorted(out, key=lambda h: h.created_at)

    # -- villains ------------------------------------------------------------
    def add_villain(self, name, codename, power="", scheme="", arc="",
                    voice_id="", threat_level="street", design="") -> Villain:
        v = Villain(name=name, codename=codename, power=power, scheme=scheme,
                    arc=arc, voice_id=voice_id, threat_level=threat_level, design=design)
        self.data["villains"][v.id] = v.to_dict(); self._save()
        return v

    def get_villain(self, vid: str) -> Villain:
        d = self.data["villains"].get(vid)
        if not d:
            raise ApprovalError(f"villain {vid} not found")
        return Villain(**d)

    def submit_villain(self, vid, by="agent", note=""):
        v = self.get_villain(vid); v.submit(by, note)
        self.data["villains"][vid] = v.to_dict(); self._save()

    def approve_villain(self, vid: str, by: str, note: str = ""):
        v = self.get_villain(vid); v.approve(by, note)
        self.data["villains"][vid] = v.to_dict(); self._save()

    def reject_villain(self, vid: str, by: str, note: str = ""):
        v = self.get_villain(vid); v.reject(by, note)
        self.data["villains"][vid] = v.to_dict(); self._save()

    def villains(self, status=None) -> list[Villain]:
        out = [Villain(**d) for d in self.data["villains"].values()]
        if status:
            out = [v for v in out if v.status == status]
        return sorted(out, key=lambda v: v.created_at)

    # -- voices --------------------------------------------------------------
    def set_voice(self, role: str, character: str, voice_id: str,
                  backend: str = "elevenlabs", by: str = "agent", status: str = DRAFT) -> dict:
        key = f"{role}:{character}"
        rec = self.data["voices"].get(key, {})
        rec.update({
            "role": role, "character": character, "voice_id": voice_id,
            "backend": backend, "status": status, "updated_by": by,
            "updated_at": datetime.now(timezone.utc).isoformat(),
        })
        self.data["voices"][key] = rec
        self._save()
        return rec

    def voices(self, status=None) -> dict:
        if status:
            return {k: v for k, v in self.data["voices"].items() if v.get("status") == status}
        return dict(self.data["voices"])

    def approved_character_voices(self) -> dict:
        return {k: v for k, v in self.data["voices"].items() if v.get("status") == APPROVED}

    # -- sagas ---------------------------------------------------------------
    def add_saga(self, title, phase="Phase 1", blurb="", beats=None,
                 hero_ids=None, villain_ids=None, age_rating="G") -> Saga:
        s = Saga(title=title, phase=phase, blurb=blurb, beats=beats or [],
                 hero_ids=hero_ids or [], villain_ids=villain_ids or [], age_rating=age_rating)
        self.data["sagas"][s.id] = s.to_dict(); self._save()
        return s

    def get_saga(self, sid): return Saga(**self.data["sagas"][sid])

    def submit_saga(self, sid, by="agent"):
        s = self.get_saga(sid); s.submit(by)
        self.data["sagas"][sid] = s.to_dict(); self._save()

    def approve_saga(self, sid, by): 
        s = self.get_saga(sid); s.approve(by)
        self.data["sagas"][sid] = s.to_dict(); self._save()

    def sagas(self, status=None):
        out = [Saga(**d) for d in self.data["sagas"].values()]
        if status:
            out = [s for s in out if s.status == status]
        return sorted(out, key=lambda s: s.created_at)

    # -- universe -------------------------------------------------------------
    def create_universe(self, name="", tagline="", core_theme="", tone="",
                        kids_strategy="", adults_strategy="") -> Universe:
        u = Universe(name=name or self.universe_name, tagline=tagline,
                     core_theme=core_theme, tone=tone, kids_strategy=kids_strategy,
                     adults_strategy=adults_strategy)
        # only draft by default; never auto-approved
        self.data["universe"] = u.to_dict()
        self._save()
        return u

    def get_universe(self) -> Optional[Universe]:
        d = self.data.get("universe")
        return Universe(**d) if d else None

    def universe_status(self) -> str:
        u = self.get_universe()
        return u.status if u else "none"

    # -- reporting ------------------------------------------------------------
    def summary(self) -> dict:
        return {
            "universe": self.universe_status(),
            "heroes": {s: len(self.heroes(s)) for s in ["draft", "review", "approved", "rejected"]},
            "villains": {s: len(self.villains(s)) for s in ["draft", "review", "approved", "rejected"]},
            "sagas": {s: len(self.sagas(s)) for s in ["draft", "review", "approved", "rejected"]},
            "voices_pending": len(self.voices("draft")),
            "voices_approved": len(self.voices("approved")),
            "file": str(self.data_path),
        }

    def pending_approvals(self) -> list[dict]:
        out = []
        for h in self.heroes("review"):
            out.append({"type": "hero", "id": h.id, "name": h.name, "codename": h.codename})
        for v in self.villains("review"):
            out.append({"type": "villain", "id": v.id, "name": v.name})
        for s in self.sagas("review"):
            out.append({"type": "saga", "id": s.id, "title": s.title})
        for k, v in self.data["voices"].items():
            if v.get("status") == "draft":
                out.append({"type": "voice", "key": k, "character": v.get("character"), "voice_id": v.get("voice_id")})
        return out

