    def synthesize(
        self,
        text: str,
        voice_id: str,
        output_format: str = "mp3_22050_64",
        voice_settings: Optional[dict[str, Any]] = None,
        metadata: Optional[dict[str, Any]] = None,
        filename: Optional[str] = None,
    ) -> str:
        """Synthesize speech and save to a file.

        Returns:
            Path to the saved audio file.
        """
        if output_format not in self.SUPPORTED_FORMATS:
            raise ValueError(f"Unsupported output format: {output_format}. Supported: {self.SUPPORTED_FORMATS}")

        if self.mock_mode:
            return self._mock_synthesize(text, voice_id, output_format, voice_settings, filename)

        # Real synthesis
        url = f"{self.base_url}/text-to-speech"
        headers = {
            "Accept": "application/json",
            "xi-api-key": self.api_key,
            "Content-Type": "application/json",
        }
        payload: dict[str, Any] = {
            "text": text,
            "voice_id": voice_id,
            "model_id": "eleven_turbo_v2_5",
            "voice_settings": voice_settings or {},
            "output_format": output_format,
            "optimize_streaming_latency": "0",
            "disable_webm_fragmentation": False,
        }
        resp = requests.post(url, headers=headers, json=payload, timeout=60)
        resp.raise_for_status()
        data = resp.json()
        audio_url = data.get("audio_url")
        if not audio_url:
            raise RuntimeError("ElevenLabs response missing audio_url")

        # Fetch the audio
        audio_resp = requests.get(audio_url, headers=headers, timeout=60)
        audio_resp.raise_for_status()

        # Determine filename
        if filename is None:
            text_hash = str(hash(text))[:8]
            voice = self.voice_by_id.get(voice_id, {}).name.replace(" ", "_")
            timestamp = datetime.now(timezone.utc).strftime("%Y%m%d_%H%M%S")
            filename = f"{voice}_{timestamp}_{text_hash}.{output_format.split('_')[0]}"

        file_path = self.output_root / filename
        file_path.parent.mkdir(parents=True, exist_ok=True)
        file_path.write_bytes(audio_resp.content)

        # Save metadata
        meta = AudioMetadata(
            voice_id=voice_id,
            model_id="eleven_turbo_v2_5",
            voice_settings=voice_settings or {},
            duration_ms=data.get("duration_ms", 0),
            file_size_bytes=len(audio_resp.content),
        )
        meta_path = file_path.with_suffix(".meta.json")
        with open(meta_path, "w") as f:
            json.dump(meta.__dict__, f, indent=2)

        return str(file_path)

    def synthesize_bytes(
        self,
        text: str,
        voice_id: str,
        output_format: str = "mp3_22050_64",
