def main():
    parser = argparse.ArgumentParser(
        prog="mindmex",
        description="MindMex AI Story Factory - Superhero children's series automation",
        epilog=(
            "Examples:\n"
            "  mindmex create --name 'The Cosmic Hero' --hero Lumina --world Nebula\n"
            "  mindmex run --series the-cosmic-hero --episodes 3\n"
            "  mindmex plan --series-bible the-cosmic-hero-bible.json --count 5\n"
            "  mindmex export-youtube --series the-cosmic-hero\n"
            "  mindmex export-print --series the-cosmic-hero\n"
            "  mindmex export-all --series the-cosmic-hero --youtube --print\n"
            "  mindmex validate\n"
            "  # Human-in-the-loop universe (George Stanley + your approval)\n"
            "  mindmex new-universe --universe 'My Empire' --inspiration 'quest, mentor, artifact'\n"
            "  mindmex list-pending\n"
            "  mindmex approve <id>   (or --note 'love it')\n"
            "  mindmex reject <id> --note 'too dark'\n"
            "  mindmex voice-pick --role hero --character Seraph --voice-id <voice> --approve\n"
            "  mindmex empire-status\n"
            "  mindmex pitch\n"
        ),
    )
    subparsers = parser.add_subparsers(dest="command", help="Available commands")

    # create-series
    create = subparsers.add_parser("create", help="Create a new series bible")
    create.add_argument("--name", required=True, help="Series name")
    create.add_argument("--hero", required=True, help="Hero name")
    create.add_argument("--world", required=True, help="World/setting name")
    create.add_argument("--art-style", required=True, help="Art style description")
    create.add_argument("--tone", required=True, help="Tone/mood")
    create.add_argument("--age", type=int, required=True, help="Target age")
    create.add_argument("--moral", help="Comma-separated moral themes")
    create.set_defaults(func=create_series)

    # plan-episodes
    plan = subparsers.add_parser("plan", help="Plan episodes for a series")
    plan.add_argument("--series-bible", help="Path to series bible JSON")
    plan.add_argument("--name", help="Series name (if no bible)")
    plan.add_argument("--hero", help="Hero name (if no bible)")
    plan.add_argument("--world", help="World name (if no bible)")
    plan.add_argument("--art-style", help="Art style (if no bible)")
    plan.add_argument("--tone", help="Tone (if no bible)")
    plan.add_argument("--age", type=int, help="Target age (if no bible)")
    plan.add_argument("--moral", help="Moral themes (if no bible)")
    plan.add_argument("--count", type=int, default=3, help="Number of episodes")
    plan.set_defaults(func=plan_episodes)

    # export youtube
    yt = subparsers.add_parser("export-youtube", help="Export YouTube metadata")
    yt.add_argument("--series", required=True, help="Series slug or bible path")
    yt.add_argument("--real", action="store_true", help="Use real API (requires keys)")
    yt.set_defaults(func=export_youtube)

    # export audiobook
    audio = subparsers.add_parser("export-audiobook", help="Export audiobook SSML")
    audio.add_argument("--series", required=True, help="Series slug or bible path")
    audio.set_defaults(func=export_audiobook)

    # export print
    pr = subparsers.add_parser("export-print", help="Export print-ready book files")
    pr.add_argument("--series", required=True, help="Series slug or bible path")
    pr.add_argument("--real", action="store_true", help="Use real API (requires keys)")
    pr.set_defaults(func=export_print)

    # export all
    all_exp = subparsers.add_parser("export-all", help="Export for YouTube and print")
    all_exp.add_argument("--series", required=True, help="Series slug")
    all_exp.add_argument("--youtube", action="store_true", help="Export YouTube assets")
    all_exp.add_argument("--print", action="store_true", help="Export print-ready books")
    all_exp.add_argument("--real", action="store_true", help="Use real API (requires keys)")
    all_exp.set_defaults(func=export_all)

    # run production
    run = subparsers.add_parser("run", help="Run full production pipeline")
    run.add_argument("--series", required=True, help="Series slug or bible path")
    run.add_argument("--episodes", type=int, default=3, help="Number of episodes to produce")
    run.add_argument("--real", action="store_true", help="Use real API (requires keys)")
    run.set_defaults(func=run_pipeline)

    # validate
    val = subparsers.add_parser("validate", help="Validate pipeline configuration")
    val.add_argument("--real", action="store_true", help="Check real API keys")
    val.add_argument("--output-root", action="store_true", help="Show output root (optional)")
    val.set_defaults(func=validate)

    # publish to youtube
    pub = subparsers.add_parser("publish-youtube", help="Publish approved episodes to YouTube (OAuth; mock w/o creds)")
    pub.add_argument("--series", required=True, help="Series slug / master manifest")
    pub.add_argument("--real", action="store_true", help="Use real YouTube OAuth (requires Google creds)")
    pub.set_defaults(func=publish_youtube)

    # verify self-check
    vchk = subparsers.add_parser("verify", help="Run a quick self-check battery")
    vchk.set_defaults(func=verify)

    # serve as MCP server over stdio
    srvp = subparsers.add_parser("serve", help="Run as an MCP server over stdio")
    srvp.set_defaults(func=serve)

    # doctor: show full fallback ladder

    vchk = subparsers.add_parser("doctor", help="Show the complete fallback ladder (guaranteed output)")
    vchk.set_defaults(func=doctor)

    # ---- Empire / George Stanley (human-in-the-loop) ----

    nu = subparsers.add_parser("new-universe", help="George Stanley drafts a new ORIGINAL universe (for your approval)")
    nu.add_argument("--universe", default="New Empire", help="Universe title")
    nu.add_argument("--inspiration", help="Generic themes/archetypes to riff on (no brand names)")
    nu.add_argument("--heroes", nargs="*", help="Optional hero archetypes (generic)")
    nu.set_defaults(func=new_universe)

