#!/usr/bin/env python3
"""
George Stanley Agent — the creative engine behind MindMex.

Its job: dream up a NEW, ORIGINAL superhero empire — pitched to kids AND adults —
that can grow new generations of fans the way Marvel did, driven by original
characters (not copies of Marvel/DC/Nickelodeon). Every output lands as a DRAFT
gated on human approval (see empire.py / the LO showrunner).

Generation modes (all produce DRAFT entities for review, never auto-approved):
    generate_universe()   -> the shared world bible (theme, tone, kids+adults strategy)
    generate_hero()       -> original hero: powers, weakness, design, story hooks
    generate_villain()    -> original nemesis: power, scheme, season arc
    generate_saga()       -> multi-season storyline tying approved heroes+villains
    generate_pitch()      -> a short "pitch deck" summary for the LO

Uses the OpenRouter router (openrouter_client.py) in live mode; deterministic
original mock output when no key is set, so the whole thing works offline.

IP guardrails (hard-coded): the agent is instructed to create only original IP.
It never reproduces trademarked characters (Marvel, DC, Nickelodeon, etc.). The
*surface* of the request (archetypes like He-Man-style mentor, Dora-style
quest, Indiana-Jones-style artifact hunt) shapes the pitch, but names, worlds and
lore are synthesized fresh.
"""

import json
import os
from typing import Any, Optional

class GeorgeStanleyAgent:
    """Generates original superhero-universe content as human-reviewable drafts."""

    def __init__(self, empire=None, router: Optional[OpenRouterRouter] = None):
        self.empire = empire
        self.router = router or OpenRouterRouter(mock_mode=False)
        self.mock = self.router.mock_mode

    # ------------------------------------------------------------------
    # Universe
    # ------------------------------------------------------------------
    def generate_universe(self, empire, inspiration: str = "") -> dict:
        sysp = (
            "You are George Stanley, an original IP world-builder. Create a NEW fictional "
            "superhero universe from scratch that is built to win over BOTH young kids and "
            "older fans. It must read like a fresh empire (a new Marvel), NOT a copy of any "
            "existing trademarked universe. Every element must be original. "
            "You may take only generic archetype/inspiration prompts, never specific brands. "
            "Return STRICT JSON."
        )
        usr = (
            "Inspiration (generic themes only): " + (inspiration or
            "an adventurous mentor hero, a curious explorer, a noble swordsman, a clever "
            "inventor, courage, friendship, self-belief") + "\n"
            "Return JSON with keys: name, tagline, core_theme, tone, kids_strategy, "
            "adults_strategy. Keep names and lore fully original."
        )
        return self._json("script", sysp, usr)

    # ------------------------------------------------------------------
    # Hero
    # ------------------------------------------------------------------
    def generate_hero(self, empire, universe_tone: str = "", roles: list | None = None) -> dict:
        roles = roles or ["an adventurous young hero", "their wise mentor", "their clever inventor partner"]
        sysp = (
            "You are George Stanley, an original IP creator. Design an ORIGINAL superhero "
            "character for a children-and-adults universe. Do NOT imitate any existing "
            "trademarked superhero. Give it believable special abilities WITH a real "
            "weakness (so stories have stakes), a magnetic personality, a strong visual "
            "design seed for image generation, and 3-4 story hooks. For kids it must be "
            "inspiring; for adults it must have depth. Return STRICT JSON."
        )
        usr = (
            f"Universe tone: {universe_tone or 'whimsical, adventurous, gentle'}\n"
            f"Character archetype to riff on (generic): {roles[0]}\n"
            "Return JSON with keys: name, codename, powers (list), weakness, origin, "
            "design (image prompt), personality, age_rating, flags (list like "
            "['kids_favorite','adult_depth']), hooks (list of 3). Fully original only."
        )
        return self._json("script", sysp, usr)

    # ------------------------------------------------------------------
    # Villain
    # ------------------------------------------------------------------
    def generate_villain(self, empire, hero_name: str = "", tier: str = "street") -> dict:
        sysp = (
            "You are George Stanley, original IP creator. Design an ORIGINAL villain/nemesis "
            "for a superhero series (kids + adults). Do NOT imitate any trademarked villain. "
            "Give it a unique power, a believable scheme, and a multi-season arc so it can "
            "grow. Threat tiers: street/state/cosmic. Return STRICT JSON."
        )
        usr = (
            f"Rival for hero: {hero_name or 'an original hero'}\n"
            f"Threat tier: {tier}\n"
            "Return JSON keys: name, codename, power, scheme, arc, threat_level, "
            "design (image prompt). Fully original."
        )
        return self._json("script", sysp, usr)

    # ------------------------------------------------------------------
    # Saga
    # ------------------------------------------------------------------
    def generate_saga(self, empire, title: str = "", phase: str = "Phase 1",
                      hero_names: list | None = None, villain_names: list | None = None) -> dict:
        sysp = (
            "You are George Stanley, showrunner for an ORIGINAL superhero universe. "
            "Outline a multi-season storyline (a 'Phase') that delivers a satisfying arc "
            "for kids AND layered drama for adults, tying the given heroes and villains "
            "together. Do NOT reference any existing franchise. Return STRICT JSON."
        )
        usr = (
            f"Phase title: {title or 'Untitled Phase'}\n"
            f"Heroes: {', '.join(hero_names or ['original hero'])}\n"
            f"Villains: {', '.join(villain_names or ['original villain'])}\n"
            "Return JSON keys: title, phase, blurb, beats (list of 4-6 storyline beats), "
            "age_rating. Fully original."
        )
        return self._json("script", sysp, usr)

    # ------------------------------------------------------------------
    # Pitch
    # ------------------------------------------------------------------
    def generate_pitch(self, empire) -> str:
        u = empire.get_universe()
        heroes = [h for h in empire.heroes() if h.status == "approved"]
        villains = [v for v in empire.villains() if v.status == "approved"]
        sagas = [s for s in empire.sagas() if s.status == "approved"]
        lines = [f"# {u.name if u else 'New Empire'} — Pitch",
                 f"Tagline: {u.tagline if u else '-'}",
                 f"Theme: {u.core_theme if u else '-'}"]
        if heroes:
            lines.append("\n## Heroes (approved)")
            lines += [f"- {h.codename or h.name}: {h.personality[:90]} | weakness: {h.weakness}" for h in heroes]
        if villains:
            lines.append("\n## Villains (approved)")
            lines += [f"- {v.codename or v.name}: {v.scheme[:90]}" for v in villains]
        if sagas:
            lines.append("\n## Sagas (approved)")
            lines += [f"- {s.title}: {s.blurb[:110]}" for s in sagas]
        lines.append("\n_Pending human approval gates the whole pipeline._")
        return "\n".join(lines)

    # ------------------------------------------------------------------
    # helpers
    # ------------------------------------------------------------------
    def _json(self, task: str, sysp: str, usr: str) -> dict:
        try:
            r = self.router.generate_json(task, sysp, usr)
        except Exception:
            r = None
        return r or self._fallback_json(usr)

    def _fallback_json(self, hint: str = "") -> dict:
        """Deterministic ORIGINAL mock output so the generator works offline.
        Varies slightly with the input hint so multiple drafted heroes are distinct."""
        import random
        seed = sum(ord(c) for c in hint) if hint else 7
        rnd = random.Random(seed)
        pre = ["Star", "Astral", "Nova", "Thunder", "Solar", "Prism", "Lumen", "Cosmic"]
        suf = ["Runner", "Guardian", "Prime", "Blade", "Pulse", "Knight", "Scribe", "Seeker"]
        name = rnd.choice(pre) + "-" + rnd.choice(suf)
        return {
            "name": name.title(), "codename": name.lower(),
            "powers": ["astral projection", "advanced agility", "empathic sense"],
            "weakness": "must recharge from sunlight once daily",
            "origin": "discovered a dormant stellar core beneath their home",
            "design": "vibrant watercolor, cosmic hero in flowing energy-cloak, starry nebula bg",
            "personality": "brave but kind, curious, believes everyone has a spark of greatness",
            "age_rating": "G",
            "flags": ["kids_favorite", "adult_depth"],
            "hooks": ["a choice that tests their courage", "an unlikely friend", "a secret in their past"],
            "scheme": "claims the power of three lost beacons to dim all light",
            "arc": "rises from one world's threat to a cosmic-level nemesis across phases",
            "threat_level": "street",
            "tagline": "Every hero begins as a spark.",
            "core_theme": "courage, friendship, self-belief",
            "tone": "whimsical, adventurous, gentle",
            "kids_strategy": "bright heroes, clear morals, fun sidekicks, safe thrills",
            "adults_strategy": "serialized arcs, mixed shades of gray, believable stakes",
            "blurb": "A season spanning a young hero's first journey and the return of an old threat.",
            "beats": ["the hero rises", "the mentor reveals a cost", "an ally is tested", "the villain escalates", "a hard sacrifice", "dawn breaks"],
        }

