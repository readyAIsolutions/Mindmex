        comic = bl.export_comic(slug)
        print('  PDF:  ' + str(pdf))
        print('  EPUB: ' + str(epub))
        print('  Comic:' + str(comic))
        return [pdf, epub, comic]

    def validate_all(self) -> Dict[str, Any]:
        """Run validation checks on the pipeline state."""
        validation = {
            "mock_mode": self.mock_mode,
            "clients": {
                "openrouter": self.openrouter is not None,
                "elevenlabs": self.elevenlabs is not None,
                "heygen": self.heygen is not None,
