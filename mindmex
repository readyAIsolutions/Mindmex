#!/usr/bin/env python3
"""
MindMex Media Provider Registry (real REST clients + mock fallback).

Unifies the best-in-class 2026 video/image APIs behind ONE interface so the
pipeline can swap providers (or mix paid + free) without changing code.

Providers implemented (thin REST clients):
    Runway   — https://dev.runway.com  / docs.dev.runwayml.com  (Gen-4.5-class)
    Luma     — https://docs.lumalabs.ai/llms.txt  (Dream Machine API)
    Pika     — https://pika.art  (Pika API / API Club; aggregates many models)
    HeyGen   — https://developers.heygen.com/llms.txt (avatar/narration/lipsync)

Each client:
    - Uses the vendor REST endpoint when the matching API key is set in .env
    - Falls back to deterministic MOCK mode when the key is absent, so the
      whole MindMex pipeline works offline and in CI.

Recommended aggregation: use Runway or Pika as the SCENE generator (they
aggregate Kling / Veo / Seedance / MiniMax under the hood), and HeyGen for
the TALKING NARRATOR (character consistency across a series). Luma for cheap,
high-volume clips.

Environment variables (see .env.example):
    RUNWAY_API_KEY     Luma via LUMA_API_KEY   Pika via PIKA_API_KEY
    HEYGEN_API_KEY     STABILITY_API_KEY (images, optional)

Webhooks / polling: video/video/image gen endpoints are ASYNC. get() polls
until status is ready; callback_url is optional.
"""

import json
import os
import time
import urllib.request
import urllib.error
from dataclasses import dataclass, field
from pathlib import Path
from typing import Any, Optional

import requests

# ---------------------------------------------------------------------------
# Result types
# ---------------------------------------------------------------------------

@dataclass
class AssetResult:
    kind: str                      # "video" | "image" | "audio" | "avatar"
    id: str
    status: str                    # "ready" | "processing" | "failed" | "mock"
    urls: list[str] = field(default_factory=list)
    provider: str = ""
    latency_ms: Optional[int] = None
    mock: bool = False
    meta: dict[str, Any] = field(default_factory=dict)

class ProviderError(Exception):
    pass

# ---------------------------------------------------------------------------
# Base client
# ---------------------------------------------------------------------------

class MediaProvider:
    name = "base"
    env_var = ""

    def __init__(self, api_key: str | None = None, mock_mode: bool | None = None):
        self.api_key = api_key or os.getenv(self.env_var)
        self.mock_mode = self.mock_mode_override(mock_mode)
        self.output_dir = Path(os.getenv("MINDMEX_OUTPUT", "/home/nova/Downloads/MindMex/output"))

    def mock_mode_override(self, mock_mode: bool | None) -> bool:
        if mock_mode is not None:
            return mock_mode
        return not bool(self.api_key)

    def _headers(self) -> dict:
        return {"Content-Type": "application/json"}

    def _post_json(self, url, payload) -> dict:
        r = requests.post(url, headers=self._headers(), json=payload, timeout=120)
        if r.status_code >= 400:
            raise ProviderError(f"{self.name} HTTP {r.status_code}: {r.text[:300]}")
        return r.json()

    def _get_json(self, url) -> dict:
        r = requests.get(url, headers=self._headers(), timeout=120)
        if r.status_code >= 400:
            raise ProviderError(f"{self.name} HTTP {r.status_code}: {r.text[:300]}")
        return r.json()

    def _mock_asset(self, kind: str) -> AssetResult:
        asset = AssetResult(
            kind=kind, id=f"{self.name}-mock-{abs(hash(kind)) % 9999}",
            status="ready", urls=[], provider=self.name, mock=True,
            meta={"note": "mock; set API key to generate for real"},
        )
        return asset

# ---------------------------------------------------------------------------
# Runway (Gen-4.5-class / Dev API)
# ---------------------------------------------------------------------------

class RunwayProvider(MediaProvider):
    name = "Runway"
    env_var = "RUNWAY_API_KEY"
    base = "https://api.dev.runwayml.com/v1"

    def gen_video(self, prompt: str, image_url: str | None = None,
                  duration: int = 10, seed: int | None = None,
                  callback_url: str | None = None) -> AssetResult:
        if self.mock_mode:
            return self._mock_asset("video")
        payload = {"prompt": prompt, "duration": duration}
        if image_url:
            payload["init_image"] = image_url
        if seed is not None:
            payload["seed"] = seed
        if callback_url:
            payload["webhook"] = callback_url
        data = self._post_json(f"{self.base}/tasks", payload)
        task_id = data.get("id")
        return self._poll_task(task_id, "video")

    def _poll_task(self, task_id, kind, max_waits=10, delay=5.0) -> AssetResult:
        for _ in range(max_waits):
            d = self._get_json(f"{self.base}/tasks/{task_id}")
            status = d.get("status", "").lower()
            if status in ("succeeded", "complete"):
                urls = [d.get("artifacts", [{}])[0].get("url")] if d.get("artifacts") else []
                return AssetResult(kind=kind, id=task_id, status="ready", urls=urls, provider=self.name)
            if status in ("failed", "error"):
                return AssetResult(kind=kind, id=task_id, status="failed", provider=self.name)
            time.sleep(delay)
        return AssetResult(kind=kind, id=task_id, status="processing", provider=self.name)

# ---------------------------------------------------------------------------
# Luma (Dream Machine API)
# ---------------------------------------------------------------------------

class LumaProvider(MediaProvider):
    name = "Luma"
    env_var = "LUMA_API_KEY"
    base = "https://api.lumalabs.ai/dream-machine/v1"

    def _headers(self):
        return {"Authorization": f"Bearer {self.api_key}", "Content-Type": "application/json"}

    def gen_video(self, prompt: str, image_url: str | None = None,
                  aspect_ratio: str = "16:9", duration: int = 5,
                  callback_url: str | None = None) -> AssetResult:
        if self.mock_mode:
            return self._mock_asset("video")
        payload = {"prompt": prompt, "aspect_ratio": aspect_ratio}
        if image_url:
            payload["image_url"] = image_url
        if callback_url:
            payload["callback_url"] = callback_url
        data = self._post_json(f"{self.base}/generations", payload)
        gid = data.get("id")
        return self._poll_generation(gid, "video")

    def _poll_generation(self, gid, kind, max_waits=12, delay=5.0) -> AssetResult:
        for _ in range(max_waits):
            d = self._get_json(f"{self.base}/generations/{gid}")
            state = d.get("state", "").lower()
            if state == "completed":
                urls = []
                for a in d.get("assets", {}).get("video", []):
                    if isinstance(a, dict):
                        urls.append(a.get("url"))
                    elif isinstance(a, str):
                        urls.append(a)
                return AssetResult(kind=kind, id=gid, status="ready", urls=urls, provider=self.name)
            if state == "failed":
                return AssetResult(kind=kind, id=gid, status="failed", provider=self.name)
            time.sleep(delay)
        return AssetResult(kind=kind, id=gid, status="processing", provider=self.name)

