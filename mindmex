#!/usr/bin/env python3
"""
MindMex TTS Provider Registry — unified voice facade.

Picks the best available text-to-speech backend for a given character:

    free/self-hosted (no API key, open source):
        coqui-ai/TTS   -> "tts" CLI or Python (best quality local)
        rhasspy/piper  -> "piper" CLI (fast, light CPU, offline)
        suno-ai/bark   -> "bark" (emotional, non-cloning)
        myshell-ai/OpenVoice -> voice CLONING from a short clip
    premium:
        ElevenLabs     -> elevenlabs_client.py (SSML, cloning, 70+ langs)

Usage:
    tts = TTSRegistry()
    tts.synthesize(character="narrator", text="...", out="narr.wav")
    # Auto-selects: ElevenLabs if key set, else local coqui/piper if installed,
    # else deterministic mock (writes a placeholder so pipeline never breaks).

Environment:
    ELEVENLABS_API_KEY   -> uses ElevenLabs when present
    COQUI_TTS_MODEL      -> default coqui model name
    PIPER_BINARY         -> path to piper if not on PATH
    MINDMEX_OUTPUT       -> audio output dir
"""

import os
import shutil
import subprocess
from dataclasses import dataclass
from pathlib import Path
from typing import Optional

@dataclass
class VoiceSpec:
    character: str
    voice_id: str | None = None        # ElevenLabs voice id (if premium)
    model: str | None = None           # coqui/piper/bark model name
    clone_source: str | None = None    # path to audio clip for OpenVoice/RVC clone
    lang: str = "en"

@dataclass
class TTSSpec:
    character: str
    text: str
    backend: str = "mock"              # elevenlabs | coqui | piper | bark | openvoice | mock
    output_file: str = ""
    latency_ms: Optional[int] = None

class TTSRegistry:
    """Resolves and runs the best TTS backend for a character."""

    def __init__(self, output_root: str | None = None):
        self.output_root = Path(output_root or os.getenv("MINDMEX_OUTPUT", "/home/nova/Downloads/MindMex/output"))
        self.elevenlabs = None
        try:
            # mock_mode=None lets the client auto-detect from the API key
            self.elevenlabs = ElevenLabsClient(mock_mode=None)
        except Exception:
            self.elevenlabs = None

    # ---- backend detection -------------------------------------------------

    VENV_BIN = Path(__file__).resolve().parent / ".venv" / "bin"

    def _has_coqui(self) -> bool:
        if shutil.which("tts") is not None:
            return True
        return (self.VENV_BIN / "tts").exists()

    def _has_piper(self) -> bool:
        if shutil.which("piper") is not None:
            return True
        if os.getenv("PIPER_BINARY"):
            return True
        return (self.VENV_BIN / "piper").exists()

    def _has_bark(self) -> bool:
        try:
            import bark  # noqa
            return True
        except Exception:
            return False

    def detect_voice(self, character: str, lang: str = "en") -> VoiceSpec:
        profile = VOICE_BANK.get(character, {})
        return VoiceSpec(
            character=character,
            voice_id=profile.get("elevenlabs_id"),
            model=profile.get("local_model"),
            lang=str(profile.get("lang", lang)),
        )

    def pick_backend(self, character: str) -> str:
        spec = self.detect_voice(character)
        # 1. ElevenLabs if key + matching voice
        if self.elevenlabs is not None and not self.elevenlabs.mock_mode and spec.voice_id:
            return "elevenlabs"
        # 2. local open-source TTS
        if self._has_coqui():
            return "coqui"
        if self._has_piper():
            return "piper"
        # 3. deterministic mock so pipeline never breaks
        return "mock"

    # ---- synthesis dispatch ------------------------------------------------

    def synthesize(self, character: str, text: str, out: str | None = None,
                   lang: str = "en", backend: str | None = None) -> TTSSpec:
        backend = backend or self.pick_backend(character)
        spec = self.detect_voice(character, lang)
        out_path = out or str(self.output_root / "audio" / f"{character}-{abs(hash(text)) % 99999}.wav")
        Path(out_path).parent.mkdir(parents=True, exist_ok=True)

        if backend == "elevenlabs":
            return self._run_elevenlabs(spec, text, out_path)
        if backend == "coqui":
            return self._run_coqui(spec, text, out_path)
        if backend == "piper":
            return self._run_piper(model=spec.model, text=text, out_path=out_path)
        # mock fallback
        Path(out_path).write_bytes(b"FAKE_AUDIO_DATA")
        return TTSSpec(character=character, text=text, backend="mock", output_file=out_path)

    def _run_elevenlabs(self, spec: VoiceSpec, text: str, out_path: str) -> TTSSpec:
        self.elevenlabs.synthesize(
            text=text, voice_id=spec.voice_id,
            output_format="wav", filename=Path(out_path).name,
        )
        return TTSSpec(spec.character, text, "elevenlabs", out_path)

    def _run_coqui(self, spec: VoiceSpec, text: str, out_path: str) -> TTSSpec:
        model = spec.model or os.getenv("COQUI_TTS_MODEL", "tts_models/en/ljspeech/tacotron2-DDC")
        cmd = ["tts", "--text", text, "--model_name", model, "--out_path", out_path]
        subprocess.run(cmd, check=False, capture_output=True, timeout=300)
        return TTSSpec(spec.character, text, "coqui", str(out_path))

    def _run_piper(self, model: str | None, text: str, out_path: str) -> TTSSpec:
        binary = os.getenv("PIPER_BINARY", "piper")
        cmd = [binary, "--output_file", out_path, "-m", model or os.getenv("PIPER_MODEL", "en_US-amy-medium")]
        proc = subprocess.run(cmd, input=text.encode(), check=False, capture_output=True, timeout=120)
        return TTSSpec(character=model or "piper", text=text, backend="piper", output_file=str(out_path))

