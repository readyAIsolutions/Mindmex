                {"id": "meta-llama/llama-3.1-8b-instruct", "name": "Llama 3.1 8B", "context_length": 131072},
            ]
        resp = self._session.get(f"{self.base_url}/models", timeout=30)
        resp.raise_for_status()
        return resp.json().get("data", [])

    def get_credits(self) -> dict[str, Any]:
        """Fetch credit balance (real mode only)."""
        if self.mock_mode:
            return {"balance": 0.0, "currency": "USD", "mock": True}
        resp = self._session.get(f"{self.base_url}/credits", timeout=30)
        resp.raise_for_status()
