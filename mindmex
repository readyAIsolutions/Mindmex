    ap.add_argument("--by", default="lo", help="Who is approving")
    ap.add_argument("--note", default="", help="Approval note")
    ap.add_argument("--universe", default="New Empire")
    ap.set_defaults(func=approve)

    rj = subparsers.add_parser("reject", help="Reject a drafted hero/villain (back to draft)")
    rj.add_argument("id", help="id of the hero/villain to reject")
    rj.add_argument("--by", default="lo")
    rj.add_argument("--note", default="", help="Why it was rejected")
    rj.add_argument("--universe", default="New Empire")
    rj.set_defaults(func=reject)

    ba = subparsers.add_parser("approve-all", help="Approve everything currently in review (fast turnaround)")
    ba.add_argument("--universe", default="New Empire")
    ba.set_defaults(func=approve_all)

    es = subparsers.add_parser("empire-status", help="Show empire approval summary")
    es.add_argument("--universe", default="New Empire")
    es.set_defaults(func=empire_status)

    vp = subparsers.add_parser("voice-pick", help="Oversee the voice choice for a character")
    vp.add_argument("--role", required=True, help="narrator|hero|mentor|villain")
    vp.add_argument("--character", help="Character name/tag (required to assign)")
    vp.add_argument("--voice-id", default="", help="Voice id (ElevenLabs) or 'piper'/'coqui'")
    vp.add_argument("--backend", default="elevenlabs", help="elevenlabs|coqui|piper|mock")
    vp.add_argument("--approve", action="store_true", help="Mark this voice as approved")
    vp.add_argument("--list", action="store_true", help="Show available voice options")
    vp.add_argument("--by", default="lo", help="Who is choosing/approving the voice")
    vp.add_argument("--universe", default="New Empire")
    vp.set_defaults(func=voice_pick)

    pt = subparsers.add_parser("pitch", help="Show the approved-universe pitch deck")
    pt.add_argument("--universe", default="New Empire")
    pt.set_defaults(func=pitch)

    args = parser.parse_args()

    if not args.command:
        parser.print_help()
        sys.exit(1)

    args.func(args)


if __name__ == '__main__':
    main()
