    def get_voice_id_by_category(self, category: str) -> Optional[str]:
        """Get the default voice ID for a given character category (hero, mentor, etc.)"""
        profile = self.voice_by_category.get(category)
        return profile.voice_id if profile else None

    def generate_ssml(
        self,
        text: str,
        voice_id: str,
        voice_settings: Optional[dict[str, Any]] = None,
        speed: float = 1.0,
        pitch: float = 1.0,
    ) -> str:
        """Generate ElevenLabs SSML for a voice (if using their SSML extensions)."""
        ssml = f'<speak><voice name="{voice_id}">'
        if speed != 1.0:
            ssml += f'<prosody rate="{speed}">'
        if pitch != 1.0:
            ssml += f'<prosody pitch="{pitch}">'
        ssml += text
        if pitch != 1.0:
            ssml += "</prosody>"
        if speed != 1.0:
            ssml += "</prosody>"
        ssml += "</voice></speak>"
        return ssml

    # ------------------------------------------------------------------
    # Post-processing helpers (audio engineering)
    # ------------------------------------------------------------------

    def trim_silence_endpoints(self, audio_path: Path, threshold: float = 0.01) -> Path:
        """Trim silence from the start and end of an audio file."""
        try:
            from pydub import AudioSegment
        except Exception:
            return audio_path  # pydub not installed, skip

        try:
            audio = AudioSegment.from_file(audio_path)
            start_trim = 0
            for i, sample in enumerate(audio):
                if abs(sample) > threshold:
                    start_trim = i
                    break
            end_trim = len(audio)
            for i, sample in enumerate(reversed(audio)):
                if abs(sample) > threshold:
                    end_trim -= i
                    break

            if start_trim == 0 and end_trim == len(audio):
                return audio_path

            trimmed = audio[start_trim:end_trim]
            out_path = audio_path.with_name(f"trimmed_{audio_path.name}")
            trimmed.export(out_path, format=audio_path.suffix[1:])
            return out_path
        except Exception:
            return audio_path

    def combine_multichannel_audio(self, audio_paths: list[Path], output_path: Path, fade_in: float = 0.5, fade_out: float = 0.5) -> Path:
        """Combine multiple audio tracks into a single file (e.g., narration + background)."""
        try:
            from pydub import AudioSegment
        except Exception:
            return audio_path  # if pydub not installed, return first file

        tracks = [AudioSegment.from_file(p) for p in audio_paths if p.exists()]
        if not tracks:
            raise ValueError("No valid audio tracks to combine")

        max_len = max(len(t) for t in tracks)
        normalized = []
        for t in tracks:
            if len(t) < max_len:
                t = t + AudioSegment.silent(duration=(max_len - len(t)))
            normalized.append(t)

        mixed = AudioSegment.silent(duration=1)
        for i, t in enumerate(normalized):
            mixed = mixed.overlay(t, position=0, gain_dB=0 - i * 3)

        mixed = mixed.fade_in(fade_in * 1000).fade_out(fade_out * 1000)
        output_path.parent.mkdir(parents=True, exist_ok=True)
        mixed.export(output_path, format=output_path.suffix[1:])
        return output_path

    # ------------------------------------------------------------------
    # Mock implementations
    # ------------------------------------------------------------------

    def _mock_synthesize(
        self,
        text: str,
        voice_id: str,
        output_format: str,
        voice_settings: Optional[dict[str, Any]],
        filename: Optional[str],
    ) -> str:
        """Return a fake file path for offline testing."""
        voice = self.voice_by_id.get(voice_id, {}).name.replace(" ", "_")
        text_hash = str(hash(text))[:8]
        timestamp = datetime.now(timezone.utc).strftime("%Y%m%d_%H%M%S")
        if filename is None:
            filename = f"{voice}_{timestamp}_{text_hash}.{output_format.split('_')[0]}"
        file_path = self.output_root / filename
        file_path.parent.mkdir(parents=True, exist_ok=True)
        file_path.write_bytes(b"FAKE_AUDIO_DATA")
        meta = AudioMetadata(
            voice_id=voice_id,
            model_id="mock_tts",
            voice_settings=voice_settings or {},
            duration_ms=1000,
            file_size_bytes=16,
        )
        meta_path = file_path.with_suffix(".meta.json")
        with open(meta_path, "w") as f:
            json.dump(meta.__dict__, f, indent=2)
        return str(file_path)

