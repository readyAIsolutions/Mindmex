# ==================================================================
#!/usr/bin/env python3
"""MindMex Video Assembler — REAL FFmpeg end-to-end episode video production.

Turns a scene plan (images + narration audio + subtitles) into a full, publishable
episode MP4 with:
    * per-scene image clips with Ken Burns pan/zoom (image -> motion video)
    * narration audio over each clip
    * burn-in subtitles (optional)
    * background music mix (optional)
    * a thethumbnail frame

Uses the system `ffmpeg` binary. Degrades to mock when the scenes only exist as
prompts (no real media on disk), so the pipeline still flows offline.

Usage:
    assembler = FFmpegVideoAssembler()
    mp4 = assembler.assemble_episode(
        scenes=[{ "image": "...", "audio": "...", "caption": "...", "duration": 8 }],
        title="The Cosmic Hero: Ep 1",
        out_path="ep1.mp4")
"""

import os
import shutil
import subprocess
from pathlib import Path

class FFmpegVideoAssembler:
    """Renders episode videos from scene images + narration via real FFmpeg."""

    def __init__(self, mock_mode: bool = False, ffmpeg_bin: str = "ffmpeg"):
        self.mock_mode = mock_mode
        self.ffmpeg = os.getenv("FFMPEG_BINARY", shutil.which(ffmpeg_bin) or ffmpeg_bin)

    # ------------------------------------------------------------------
    # High-level: assemble a whole episode
    # ------------------------------------------------------------------
    def assemble_episode(
        self,
        scenes: list[dict],
        title: str,
        out_path: str,
        image_dir: str | None = None,
        audio_dir: str | None = None,
        subtitle_path: str | None = None,
        background_music: str | None = None,
        fps: int = 30,
        res: tuple = (1280, 720),
    ) -> str:
        """
        scenes: [{ image, audio, caption, duration }]. Paths may be relative to
                image_dir / audio_dir.
        Returns path to the assembled mp4.
        """
        Path(out_path).parent.mkdir(parents=True, exist_ok=True)

        # Normalize paths and detect whether we have real media to encode.
        ready = []
        for sc in scenes:
            img, aud = sc.get("image"), sc.get("audio")
            if image_dir and img and not os.path.isabs(img):
                img = os.path.join(image_dir, img)
            if audio_dir and aud and not os.path.isabs(aud):
                aud = os.path.join(audio_dir, aud)
            ready.append({**sc, "image": img, "audio": aud})

        # Only try to encode if at least one real image file exists, else mock.
        has_media = any(s.get("image") and os.path.exists(s["image"]) for s in ready)
        if self.mock_mode or not has_media:
            return self._mock_assemble(out_path, title, ready)

        tmpdir = Path(out_path).parent / f".clips-{abs(hash(out_path)) % 99999}"
        tmpdir.mkdir(parents=True, exist_ok=True)
        try:
            clips = []
            for i, sc in enumerate(ready, start=1):
                seg = tmpdir / f"seg-{i:03d}.mp4"
                self._make_clip(sc, seg, dur=float(sc.get("duration") or 8),
                                resolution=res, fps=fps)
                clips.append(seg)

            concat = tmpdir / "concat.mp4"
            self._concat(clips, concat, fps=fps)
            final = concat

            if subtitle_path and os.path.exists(subtitle_path):
                subbed = tmpdir / "concat-subbed.mp4"
                self._burn_subtitles(final, subtitle_path, subbed)
                final = subbed

            if background_music and os.path.exists(background_music):
                mixed = tmpdir / "with-music.mp4"
                self._mix_music(final, background_music, mixed)
                final = mixed

            shutil.copy2(final, out_path)
            return out_path
        finally:
            shutil.rmtree(tmpdir, ignore_errors=True)

    # ------------------------------------------------------------------
    # Low-level ffmpeg helpers
    # ------------------------------------------------------------------
    def _run(self, args: list, **kw) -> None:
        subprocess.run(
            [self.ffmpeg, "-y", "-hide_banner", "-loglevel", "error", *args],
            check=True, capture_output=True, text=True, **kw,
        )

    def _make_clip(self, sc, seg, dur=8, resolution=(1280, 720), fps=30):
        """One image (Ken Burns zoompan) + optional narration -> one mp4 segment."""
        w, h = resolution
        img, aud = sc.get("image"), sc.get("audio")
        has_img = img and os.path.exists(img)
        has_aud = aud and os.path.exists(aud)

        if has_img:
            filter_cx = (
                f"scale={w}:{h}:force_original_aspect_ratio=increase,"
                f"crop={w}:{h},zoompan=z='min(zoom+0.0008,1.25)':"
                f"d={int(fps*dur)}:s={w}x{h}:fps={fps}"
            )
            vf = ["-vf", filter_cx]
        else:
            # Fallback color card so the segment is still a valid video.
            vf = ["-f", "lavfi", "-i", f"color=c=0x16263f:s={w}x{h}:d={dur}"]

        if has_aud:
            cmd = (["-i", img] if has_img else []) + ["-i", aud] + vf + [
                "-t", f"{dur}", "-c:v", "libx264", "-preset", "veryfast",
                "-pix_fmt", "yuv420p", "-c:a", "aac", "-b:a", "160k", "-shortest", str(seg),
            ]
        else:
            cmd = (["-i", img] if has_img else []) + vf + [
                "-t", f"{dur}", "-c:v", "libx264", "-preset", "veryfast",
                "-pix_fmt", "yuv420p", "-an", str(seg),
            ]
        self._run(cmd)

    def _concat(self, clips, out, fps=30):
        listfile = Path(out).with_suffix(".txt")
        with open(listfile, "w") as f:
            for seg in clips:
                f.write(f"file '{str(seg.resolve())}'\n")
        self._run(["-f", "concat", "-safe", "0", "-i", str(listfile),
                   "-c:v", "libx264", "-preset", "veryfast", "-c:a", "aac", str(out)])

    def _burn_subtitles(self, src, subs, dst):
        subs_safe = str(Path(subs).resolve()).replace("'", "\\'").replace(":", "\\:")
        self._run(["-i", str(src), "-vf", f"subtitles='{subs_safe}'", "-c:a", "copy", str(dst)])

    def _mix_music(self, src, music, dst):
        self._run(["-i", str(src), "-i", str(music), "-filter_complex",
                   "[1:a]volume=0.15[m];[0:a][m]amix=inputs=2:duration=first[a]",
                   "-map", "0:v", "-map", "[a]", "-c:v", "copy", "-c:a", "aac", str(dst)])

    def generate_thumbnail(self, video_path: str, thumbnail_path: str,
                           timestamp: str = "00:00:01") -> str:
        if not os.path.exists(video_path) or self.mock_mode:
            Path(thumbnail_path).parent.mkdir(parents=True, exist_ok=True)
            Path(thumbnail_path).write_bytes(b"FAKEPNG")
            return thumbnail_path
        self._run(["-ss", timestamp, "-i", video_path, "-frames:v", "1", thumbnail_path])
        return thumbnail_path

    # ------------------------------------------------------------------
    # Mock
    # ------------------------------------------------------------------
    def _mock_assemble(self, out_path, title, scenes) -> str:
        Path(out_path).parent.mkdir(parents=True, exist_ok=True)
        Path(out_path).write_bytes(b"FAKE-PUBLISHABLE-MP4")
        print(f"  [MOCK] assembled '{title}' ({len(scenes)} scene(s)) -> {out_path}")
        return out_path

