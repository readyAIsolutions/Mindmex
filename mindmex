#!/usr/bin/env python3
"""
MindMex Pipeline Orchestrator (mock-ready)

Coordinates the full pipeline with real API clients when available,
and deterministic mock outputs when keys are missing.

Clients currently supported:
  * OpenRouterRouter (model routing for text, SEO, script, storyboard, review)
  * ElevenLabsClient (voice synthesis)
  * HeyGenClient (talking avatar / video generation)
  * ImageGenClient (Stable Diffusion, Midjourney, Flux)
  * FFmpegVideoAssembler (multi-track video editing)
  * YouTubeUploader (video publishing)
  * PrintOnDemandExporter (PDF/EPUB/print-ready books)

Environment variables:
  OPENROUTER_API_KEY
  ELEVENLABS_API_KEY
  HEYGEN_API_KEY
  STABILITY_API_KEY (for Stable Diffusion)
  YOUTUBE_API_KEY
  YOUTUBE_CLIENT_ID / YOUTUBE_CLIENT_SECRET
  INGRAHAM_SPAINK_* (for POD)

Default mock mode: enabled when any required key is missing.

Usage:
    python3 orchestrator.py --run-series --series "The Cosmic Hero" --episodes 3
    python3 orchestrator.py --run-single-episode --series "The Cosmic Hero" --episode 1
    python3 orchestrator.py --validate-all
"""

import json
import os
from datetime import datetime
from pathlib import Path
from typing import Any, Dict, List

class OrchestratorError(Exception):
    pass

class MindMexPipelineOrchestrator:
    """
    Top-level orchestrator for MindMex.

    Orchestrates the complete production pipeline:
    1. Series/episode planning (from factory)
    2. Asset generation (text via OpenRouter, audio via ElevenLabs)
    3. Video production (HeyGen + image generation + FFmpeg)
    4. YouTube publishing (metadata, thumbnails, chapters)
    5. Print-on-demand exports (PDF/EPUB)
    6. Manifest updates and delivery

    The orchestrator works in "mock mode" when API keys are missing,
    producing deterministic placeholder files and console output.
    """

    def __init__(
        self,
        output_root: str = "/home/nova/Downloads/MindMex/output",
        mock_mode: bool = None,
    ):
        self.output_root = Path(output_root)
        self.mock_mode = mock_mode if mock_mode is not None else self._detect_mock_mode()

        # Initialize factory for series creation
        self.factory = AIStoryFactory(output_root=str(self.output_root))

        # Initialize clients (they are smart about mock mode)
        self.openrouter = OpenRouterRouter(mock_mode=self.mock_mode)
        self.elevenlabs = ElevenLabsClient(mock_mode=self.mock_mode)
        self.heygen = None  # Lazy import to avoid optional deps
        self.image_gen = None  # Lazy import
        self.ffmpeg = None  # Lazy import
        self.youtube = None  # Lazy import
        self.pod = None  # Lazy import

        # Create directories
        (self.output_root / "audio").mkdir(parents=True, exist_ok=True)
        (self.output_root / "video").mkdir(parents=True, exist_ok=True)
        (self.output_root / "images").mkdir(parents=True, exist_ok=True)
        (self.output_root / "manifests").mkdir(parents=True, exist_ok=True)

    # ------------------------------------------------------------------
    # Client initializers (lazy imports, optional dependencies)
    # ------------------------------------------------------------------

    def _init_heygen(self):
        try:
            from heygen_client import HeyGenClient
            self.heygen = HeyGenClient(mock_mode=self.mock_mode)
        except Exception:
            self.heygen = None

    def _init_image_gen(self):
        try:
            from image_gen_client import ImageGenClient
            self.image_gen = ImageGenClient(mock_mode=self.mock_mode)
        except Exception:
            self.image_gen = None

    def _init_ffmpeg(self):
        try:
            self.ffmpeg = FFmpegVideoAssembler(mock_mode=self.mock_mode)
        except Exception:
            self.ffmpeg = None

    def _init_youtube(self):
        try:
            self.youtube = YouTubeUploader(mock_mode=self.mock_mode)
        except Exception:
            self.youtube = None

    def _init_pod(self):
        try:
            from print_on_demand_exporter import PrintOnDemandExporter
            self.pod = PrintOnDemandExporter(
                mock_mode=self.mock_mode,
                output_root=str(self.output_root / "books"),
            )
        except Exception:
            self.pod = None

    # ------------------------------------------------------------------
    # Core orchestration methods
    # ------------------------------------------------------------------

    def run_series(self, series_slug: str, episode_count: int, metadata: Dict[str, Any] = None):
        """
        Run the full pipeline for a series.

        Steps:
        1. Load series definition (from factory or existing bible)
        2. Plan each episode (use OpenRouter for scripts, SEO, thumbnails)
        3. Generate assets (image prompts → image generation, narration → ElevenLabs)
        3. Assemble video (HeyGen + generated images + audio)
        4. Export video and audio for YouTube
        5. Upload to YouTube (if configured)
        5. Export print-ready books (POD)
        6. Update manifest and delivery
        """
        print(f"🔄 Starting pipeline for series '{series_slug}' ({episode_count} episodes)")
        metadata = metadata or {}

        # Load series definition (from factory or existing bible)
        series_path = self.output_root / f"{series_slug}-bible.json"
        if not series_path.exists():
            # Create series bible if it doesn't exist
            series = self._create_series(series_slug)
            series_path.parent.mkdir(parents=True, exist_ok=True)
            with open(series_path, "w") as f:
                json.dump(series.to_dict(), f, indent=2)
            print(f"✅ Created series bible: {series_path}")
            series_data = series.to_dict()
        else:
            with open(series_path) as f:
                series_data = json.load(f)

        # Plan and generate episodes
        for ep_num in range(1, episode_count + 1):
            self._plan_and_generate_episode(series_slug, ep_num, series_data, metadata)

        print(f"✅ Series pipeline complete for '{series_slug}'")

    def _create_series(self, series_slug: str) -> "Series":
        """Create a default series for testing."""
        series = self.factory.create_series(
            name="The Cosmic Hero",
            hero_name="Lumina Starblade",
            world="The Starry Realm of Nebula",
            art_style="vibrant watercolor, soft gradients, bold outlines, 16:9",
            tone="whimsical, adventurous, gentle",
            target_age=8,
            moral_themes=["courage", "friendship", "kindness", "self-belief"],
        )
        return series

    def _plan_and_generate_episode(self, series_slug: str, episode_number: int, series_data: Dict[str, Any], metadata: Dict[str, Any]):
        """Plan a single episode and generate its assets."""
        ep_dir = self.output_root / "episodes" / f"episode-{episode_number:03d}"
        ep_dir.mkdir(parents=True, exist_ok=True)

        # Use OpenRouter to generate episode plan (script, storyboard, SEO)
        episode_plan = self._generate_episode_plan(series_data, episode_number, metadata)

        # Generate scenes for the episode
        scenes = self._generate_scenes(episode_plan, ep_dir)

        # Generate audio for each scene
        audio_files = []
        for scene in scenes:
            audio_path = self._generate_scene_audio(scene, ep_dir)
            audio_files.append(audio_path)

        # Assemble video (if video clients available)
        video_path = self._assemble_episode_video(scenes, audio_files, ep_dir)

        # Update manifest
        self._update_manifest(series_slug, episode_number, episode_plan, scenes, audio_files, video_path)

    # ------------------------------------------------------------------
    # Asset generation helpers
    # ------------------------------------------------------------------

    def _generate_episode_plan(self, series_data: Dict[str, Any], episode_number: int, metadata: Dict[str, Any]) -> Dict[str, Any]:
        """Generate a complete episode plan using OpenRouter (with mock fallback)."""
        system_prompt = (
            "You are a senior story planner for a children's superhero series. "
            "Generate structured episode content for episode {episode_number} of series '{series_name}'. "
            "Focus on age-appropriate content, clear 3-act structure, strong moral, and engaging visuals."
        )

        user_prompt = f"""
Series: {series_data.get('name', 'The Cosmic Hero')}
Episode Number: {episode_number}
Series Theme: {series_data.get('moral_themes', [])}
Target Age: {series_data.get('target_age', 8)}
Additional Metadata: {metadata}

Please provide:
1. Episode title
2. Villain name/description
3. Core problem (1-2 sentences)
4. Moral lesson
5. 3-Act structure outline (simple sentences)
6. SEO title (max 60 chars)
7. SEO description (max 160 chars)
8. YouTube thumbnail text (title + subtitle)

Format as JSON:
{{
  "title": "...",
  "villain": "...",
  "problem": "...",
  "moral": "...",
  "act_one": "...",
  "act_two": "...",
  "act_three": "...",
  "seo_title": "...",
  "seo_description": "...",
  "thumbnail_text": "..."
}}
"""
        try:
            result: GenerationResult = self.openrouter.generate("script", system_prompt, user_prompt)
            return json.loads(result.content)
        except Exception:
            # Fallback: create a deterministic plan for mock mode
            return {
                "title": f"Episode {episode_number}: The {series_data.get('hero_name', 'Hero')} Adventure",
                "villain": "The Shadow Maw",
                "problem": "The hero faces a challenge that tests their courage.",
                "moral": "Friendship and bravery overcome fear.",
                "act_one": "The hero discovers a problem.",
                "act_two": "The hero learns and grows through the journey.",
                "act_three": "The hero resolves the problem with courage.",
                "seo_title": f"Lumina Starblade Episode {episode_number}",
                "seo_description": "A superhero children's story about courage and friendship.",
                "thumbnail_text": "Lumina Starblade vs The Shadow Maw!",
            }

    def _generate_scenes(self, episode_plan: Dict[str, Any], ep_dir: Path) -> List[Scene]:
        """Generate scenes for an episode using OpenRouter."""
        # This is a simplified scene generation; in reality, you'd use more detailed prompts
        scene_prompts = []
        for i in range(1, 4):  # Generate 3 scenes per episode as a demo
            scene_prompt = f"Scene {i}: {episode_plan.get('act_one', '') if i == 1 else episode_plan.get('act_two', '') if i == 2 else episode_plan.get('act_three', '')}"
            scene_prompts.append(scene_prompt)

        scenes = []
        for i, prompt in enumerate(scene_prompts, start=1):
            image_prompt_result = self.openrouter.generate("image_prompt", "", f"Generate a children's book illustration: {prompt}")
            thumbnail_prompt_result = self.openrouter.generate("thumbnail_prompt", "", f"Generate a YouTube thumbnail for a superhero story: {prompt}")
            script_result = self.openrouter.generate("script", "", f"Write a children's story script for scene {i}: {prompt}")

            scene = Scene(
                number=i,
                title=f"Scene {i}",
                description=prompt,
                image_prompt=image_prompt_result.content,
                thumbnail_prompt=thumbnail_prompt_result.content,
                narration_script=script_result.content,
                duration_seconds=120,
                audiobook_ssml=f"<speak>{script_result.content}</speak>",
                heyjen_visual="friendly_narrator",
                heyjen_audio_text=script_result.content,
            )
            scenes.append(scene)
        return scenes

    def _generate_scene_audio(self, scene: Scene, ep_dir: Path) -> str:
        """Generate audio for a single scene using ElevenLabs."""
        voice_id = self.elevenlabs.get_voice_id_by_category("narrator") or self.elevenlabs.get_voice_id_by_category("hero")
        if not voice_id:
            return ""

        audio_path = self.elevenlabs.synthesize(
            text=scene.narration_script,
            voice_id=voice_id,
            output_format="mp3_22050_64",
            filename=f"scene-{scene.number}.mp3",
        )
        return audio_path

    def _assemble_episode_video(self, scenes, audio_files, ep_dir):
        asm = FFmpegVideoAssembler(mock_mode=self.mock_mode)
        specs = []
        for sc, aud in zip(scenes, audio_files):
            img = ep_dir / ('scene-%d.png' % sc.number)
            specs.append({'image': str(img) if img.exists() else None,
                          'audio': aud if aud and os.path.exists(aud) else None,
                          'caption': sc.title, 'duration': sc.duration_seconds})
        out = ep_dir / 'episode_video.mp4'
        return asm.assemble_episode(specs, title='Episode', out_path=str(out))

    def _update_manifest(self, series_slug: str, episode_number: int, episode_plan: Dict[str, Any], scenes: List[Scene], audio_files: List[str], video_path: str):
        """Update the master manifest with generated assets."""
        manifest_path = self.output_root / "manifests" / f"{series_slug}-master.json"

        if manifest_path.exists():
            with open(manifest_path) as f:
                manifest = json.load(f)
        else:
            manifest = {"series": {}, "episodes": []}

        # Ensure series entry
        if "series" not in manifest:
            manifest["series"] = {}

        # Add episode entry
        episode_entry = {
            "episode_number": episode_number,
            "title": episode_plan.get("title"),
            "plan": episode_plan,
            "scenes": [s.to_dict() for s in scenes],
            "audio_files": audio_files,
            "video_path": video_path,
            "generated_at": datetime.now().isoformat(),
        }
        manifest["episodes"].append(episode_entry)

        with open(manifest_path, "w") as f:
            json.dump(manifest, f, indent=2)

    # ------------------------------------------------------------------
    # Client orchestration (YouTube, POD, etc.)
    # ------------------------------------------------------------------

    def export_for_youtube(self, series_slug: str):
        """Export YouTube-ready assets (metadata, thumbnails, chapters)."""
        if self.youtube is None:
            self._init_youtube()
        if self.youtube:
            self.youtube.export_series(series_slug)

    def export_for_print(self, series_slug: str):
        slug = series_slug.split('-master.json')[0].strip('/')
        bl = BookLayout(output_root=str(self.output_root / 'books'), mock_mode=self.mock_mode)
        pdf = bl.export_series_pdf(slug)
