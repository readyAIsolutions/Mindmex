# MODULE: openrouter_client.py
# ==================================================================
"""OpenRouter client for MindMex — smart model routing per task type.

Routes each pipeline stage to the right model on OpenRouter:
- script / narrative     → reasoning model (deepseek-chat, claude-3.5-sonnet)
- image prompts          → creative model (gpt-4o, claude-3-opus)
- SEO / metadata         → fast model (gpt-4o-mini, llama-3.1-8b)
- storyboard outlines    → mid-tier model (gpt-4o-mini)
- quality review         → strongest available model
- fallback chain         → automatically tries next model on failure

Environment variables:
  OPENROUTER_API_KEY   (required)
  OPENROUTER_BASE_URL  (default: https://openrouter.ai/api/v1)
  OPENROUTER_SITE_URL  (optional, for leaderboard attribution)
  OPENROUTER_APP_NAME  (optional, for leaderboard attribution)

Per-task model mapping (can be overridden via env vars):
  OPENROUTER_MODEL_SCRIPT       default: deepseek/deepseek-chat
  OPENROUTER_MODEL_IMAGE_PROMPT default: openai/gpt-4o
  OPENROUTER_MODEL_SEO          default: meta-llama/llama-3.1-8b-instruct
  OPENROUTER_MODEL_STORYBOARD   default: openai/gpt-4o-mini
  OPENROUTER_MODEL_REVIEW       default: anthropic/claude-3.5-sonnet
  OPENROUTER_MODEL_SUMMARY      default: deepseek/deepseek-chat

Usage:
    router = OpenRouterRouter()
    script = router.generate("script", system_prompt, user_prompt)
"""

import json
import os
import time
from dataclasses import dataclass, field
from typing import Any, Optional

import requests

@dataclass
class ModelRoute:
    task: str
    model: str
    temperature: float = 0.7
    max_tokens: int = 2000
    timeout: int = 60

@dataclass
class GenerationResult:
    content: str
    model: str
    task: str
    tokens_used: Optional[int] = None
    cost_usd: Optional[float] = None
    latency_ms: Optional[int] = None
    attempts: int = 1

class OpenRouterRouter:
    """
    Smart model router for OpenRouter.

    Attributes:
        api_key: OpenRouter API key.
        base_url: OpenRouter API base URL.
        routes: Mapping of task type -> ModelRoute.
        fallback_order: Ordered list of task types to try if primary fails.
        mock_mode: If True, returns deterministic fake responses (no API key needed).
    """

    DEFAULT_ROUTES: dict[str, ModelRoute] = {
        "script": ModelRoute(
            task="script",
            model=os.getenv("OPENROUTER_MODEL_SCRIPT", "deepseek/deepseek-chat"),
            temperature=0.8,
            max_tokens=3000,
        ),
        "image_prompt": ModelRoute(
            task="image_prompt",
            model=os.getenv("OPENROUTER_MODEL_IMAGE_PROMPT", "openai/gpt-4o"),
            temperature=0.9,
            max_tokens=1500,
        ),
        "seo": ModelRoute(
            task="seo",
            model=os.getenv("OPENROUTER_MODEL_SEO", "meta-llama/llama-3.1-8b-instruct"),
            temperature=0.5,
            max_tokens=1000,
        ),
        "storyboard": ModelRoute(
            task="storyboard",
            model=os.getenv("OPENROUTER_MODEL_STORYBOARD", "openai/gpt-4o-mini"),
            temperature=0.7,
            max_tokens=2000,
        ),
        "review": ModelRoute(
            task="review",
            model=os.getenv("OPENROUTER_MODEL_REVIEW", "anthropic/claude-3.5-sonnet"),
            temperature=0.3,
            max_tokens=2000,
        ),
        "summary": ModelRoute(
            task="summary",
            model=os.getenv("OPENROUTER_MODEL_SUMMARY", "deepseek/deepseek-chat"),
            temperature=0.5,
            max_tokens=1500,
        ),
        "thumbnail_copy": ModelRoute(
            task="thumbnail_copy",
            model=os.getenv("OPENROUTER_MODEL_THUMBNAIL_COPY", "openai/gpt-4o-mini"),
            temperature=0.8,
            max_tokens=500,
        ),
        # NEW: task-based prompt generation (images + thumbnails from descriptive prompts)
        "thumbnail_prompt": ModelRoute(
            task="thumbnail_prompt",
            model=os.getenv("OPENROUTER_MODEL_THUMBNAIL_PROMPT", "openai/gpt-4o-mini"),
            temperature=0.8,
            max_tokens=500,
        ),
        "image_prompt_v2": ModelRoute(
            task="image_prompt_v2",
            model=os.getenv("OPENROUTER_MODEL_IMAGE_PROMPT_V2", "openai/gpt-4o"),
            temperature=0.9,
            max_tokens=1500,
        ),
    }

    # Fallback chain: if a model fails for a task, try these task routes in order
    FALLBACK_CHAIN: list[str] = [
        "script",
        "image_prompt_v2",
        "image_prompt",
        "thumbnail_copy",
        "thumbnail_prompt",
        "storyboard",
        "seo",
        "review",
        "summary",
    ]

    def __init__(
        self,
        api_key: Optional[str] = None,
        base_url: Optional[str] = None,
        site_url: Optional[str] = None,
        app_name: Optional[str] = None,
        routes: Optional[dict[str, ModelRoute]] = None,
        mock_mode: bool = False,
    ):
        self.api_key = api_key or os.getenv("OPENROUTER_API_KEY")
        self.base_url = (base_url or os.getenv("OPENROUTER_BASE_URL", "https://openrouter.ai/api/v1")).rstrip("/")
        self.site_url = site_url or os.getenv("OPENROUTER_SITE_URL")
        self.app_name = app_name or os.getenv("OPENROUTER_APP_NAME", "MindMex")
        self.routes = routes or dict(self.DEFAULT_ROUTES)
        self.mock_mode = mock_mode or not bool(self.api_key)
        self._session = requests.Session()
        self._session.headers.update({
            "Authorization": f"Bearer {self.api_key}" if self.api_key else "",
            "Content-Type": "application/json",
        })
        if self.site_url:
            self._session.headers["HTTP-Referer"] = self.site_url
        if self.app_name:
            self._session.headers["X-Title"] = self.app_name

    # ------------------------------------------------------------------
    # Public API
    # ------------------------------------------------------------------

    def generate(
        self,
        task: str,
        system_prompt: str,
        user_prompt: str,
        model: Optional[str] = None,
        temperature: Optional[float] = None,
        max_tokens: Optional[int] = None,
        **kwargs: Any,
    ) -> GenerationResult:
        """Generate text for a given task, routing to the appropriate model.

        If the primary route fails, walks the fallback chain.
        """
        route = self.routes.get(task)
        if route is None:
            raise ValueError(f"Unknown task type: {task}. Available: {list(self.routes)}")

        model = model or route.model
        temperature = temperature if temperature is not None else route.temperature
        max_tokens = max_tokens or route.max_tokens

        if self.mock_mode:
            return self._mock_generate(task, system_prompt, user_prompt, model)

        last_error: Optional[Exception] = None
        attempts = 0

        # Try primary route first, then fallbacks
        candidates = [route] + [
            self.routes[t] for t in self.FALLBACK_CHAIN if t != task and t in self.routes
        ]

        for cand in candidates:
            attempts += 1
            try:
                return self._call(
                    task=task,
                    model=cand.model,
                    system_prompt=system_prompt,
                    user_prompt=user_prompt,
                    temperature=cand.temperature,
                    max_tokens=cand.max_tokens,
                    attempts=attempts,
                    **kwargs,
                )
            except Exception as exc:  # noqa: BLE001
                last_error = exc
                # If it's an auth error, don't waste time on fallbacks
                if isinstance(exc, requests.HTTPError) and exc.response is not None:
                    if exc.response.status_code in (401, 403):
                        raise
                continue

        raise RuntimeError(f"OpenRouter generation failed for task '{task}' after {attempts} attempts: {last_error}")

    def generate_json(
        self,
        task: str,
        system_prompt: str,
        user_prompt: str,
        model: Optional[str] = None,
        temperature: Optional[float] = None,
        max_tokens: Optional[int] = None,
        **kwargs: Any,
    ) -> dict[str, Any]:
        """Generate and parse JSON. Raises if response isn't valid JSON."""
        result = self.generate(
            task=task,
            system_prompt=system_prompt,
            user_prompt=user_prompt,
            model=model,
            temperature=temperature,
            max_tokens=max_tokens,
            **kwargs,
        )
        # Strip markdown code fences if present
        text = result.content.strip()
        if text.startswith("```json"):
            text = text[7:]
        if text.startswith("```"):
            text = text[3:]
        if text.endswith("```"):
            text = text[:-3]
        return json.loads(text.strip())

    # ------------------------------------------------------------------
    # Internal
    # ------------------------------------------------------------------

    def _call(
        self,
        task: str,
        model: str,
        system_prompt: str,
        user_prompt: str,
        temperature: float,
        max_tokens: int,
        attempts: int,
        **kwargs: Any,
    ) -> GenerationResult:
        start = time.time()

        payload: dict[str, Any] = {
            "model": model,
            "messages": [
                {"role": "system", "content": system_prompt},
                {"role": "user", "content": user_prompt},
            ],
            "temperature": temperature,
            "max_tokens": max_tokens,
            **kwargs,
        }

        resp = self._session.post(f"{self.base_url}/chat/completions", json=payload, timeout=kwargs.pop("timeout", 60))
        resp.raise_for_status()
        data = resp.json()

        latency_ms = int((time.time() - start) * 1000)
        choice = data["choices"][0]
        content = choice["message"]["content"]
        usage = data.get("usage", {})

        return GenerationResult(
            content=content,
            model=model,
            task=task,
            tokens_used=usage.get("total_tokens"),
            latency_ms=latency_ms,
            attempts=attempts,
        )

    def _mock_generate(
        self, task: str, system_prompt: str, user_prompt: str, model: str
    ) -> GenerationResult:
        """Deterministic fake response for offline testing."""
        content_map = {
