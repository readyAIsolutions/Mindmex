#!/usr/bin/env python3
"""
MindMex - AI Story Factory
==========================
End-to-end automation scaffold for a superhero / children's book series.

Produces (no external API keys required to run):
  * Series bible + episode concepts (3-act structure, moral, hero/villain)
  * Storyboard: per-scene image prompts (Midjourney / Flux / Stable Diffusion)
  * YouTube thumbnails: prompt + layout notes (Canva / Photoshop / Pillow)
  * Audiobook: ElevenLabs-compatible SSML per chapter
  * Video: HeyGen API v1 payload (talking avatar / video generation)
  * Real book: print/interior markup (HTML -> PDF / EPUB / print-on-demand)
  * YouTube metadata: title, description, tags, chapter timestamps
  * Master manifest JSON tying every asset to its file path

Run:
    python3 factory.py

Output goes to ./output/<series_slug>/ by default.
"""

import json
import os
import re
import uuid
from datetime import datetime
from pathlib import Path

# ---------------------------------------------------------------------------
# Data model
# ---------------------------------------------------------------------------

class Series:
    def __init__(self, name, hero_name, world, art_style, tone, target_age,
                 moral_themes, series_slug=None):
        self.name = name
        self.hero_name = hero_name
        self.world = world
        self.art_style = art_style
        self.tone = tone
        self.target_age = target_age
        self.moral_themes = moral_themes
        self.slug = series_slug or self._slug(name)
        self.episodes = []

    def _slug(self, text):
        return re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")

    def to_dict(self):
        return {
            "name": self.name,
            "slug": self.slug,
            "hero_name": self.hero_name,
            "world": self.world,
            "art_style": self.art_style,
            "tone": self.tone,
            "target_age": self.target_age,
            "moral_themes": self.moral_themes,
            "episode_count": len(self.episodes),
        }

class Episode:
    def __init__(self, series, number, title, villain, problem, moral,
                 act_one, act_two, act_three, scenes):
        self.id = str(uuid.uuid4())[:8]
        self.series_slug = series.slug
        self.number = number
        self.title = title
        self.villain = villain
        self.problem = problem
        self.moral = moral
        self.act_one = act_one
        self.act_two = act_two
        self.act_three = act_three
        self.scenes = scenes  # list of Scene

    def to_dict(self):
        return {
            "id": self.id,
            "number": self.number,
            "title": self.title,
            "villain": self.villain,
            "problem": self.problem,
            "moral": self.moral,
            "act_one": self.act_one,
            "act_two": self.act_two,
            "act_three": self.act_three,
            "scenes": [s.to_dict() for s in self.scenes],
        }

class Scene:
    def __init__(self, number, title, description, image_prompt,
                 thumbnail_prompt, narration_script, duration_seconds,
                 audiobook_ssml, heyjen_visual, heyjen_audio_text):
        self.number = number
        self.title = title
        self.description = description
        self.image_prompt = image_prompt
        self.thumbnail_prompt = thumbnail_prompt
        self.narration_script = narration_script
        self.duration_seconds = duration_seconds
        self.audiobook_ssml = audiobook_ssml
        self.heyjen_visual = heyjen_visual
        self.heyjen_audio_text = heyjen_audio_text

    def to_dict(self):
        return {
            "number": self.number,
            "title": self.title,
            "description": self.description,
            "image_prompt": self.image_prompt,
            "thumbnail_prompt": self.thumbnail_prompt,
            "narration_script": self.narration_script,
            "duration_seconds": self.duration_seconds,
            "audiobook_ssml": self.audiobook_ssml,
            "heyjen_visual": self.heyjen_visual,
            "heyjen_audio_text": self.heyjen_audio_text,
        }

# ---------------------------------------------------------------------------
# Generator
# ---------------------------------------------------------------------------

class AIStoryFactory:
    def __init__(self, output_root="/home/nova/Downloads/MindMex/output"):
        self.output_root = Path(output_root)

    # ---- series -----------------------------------------------------------

    def create_series(self, name, hero_name, world, art_style, tone,
                      target_age, moral_themes):
        series = Series(name, hero_name, world, art_style, tone, target_age,
                        moral_themes)
        return series

    # ---- episode ----------------------------------------------------------

    def plan_episode(self, series, number, title, villain, problem, moral,
                     act_one, act_two, act_three, scenes_cfg):
        """
        scenes_cfg: list of dicts with keys:
          title, description, image_subject, thumbnail_focus,
          narration, duration_seconds, heyjen_avatar, heyjen_voice
        """
        scenes = []
        for i, cfg in enumerate(scenes_cfg, start=1):
            image_prompt = (
                f"{series.art_style}, {series.tone}, {cfg['image_subject']}, "
                f"featuring {series.hero_name} in {series.world}, "
                f"children's book illustration, vibrant colors, "
                f"consistent character design, 16:9 storyboard panel"
            )
            thumbnail_prompt = (
                f"YouTube thumbnail, {series.art_style}, {cfg['thumbnail_focus']}, "
                f"{series.hero_name} close-up expressive face, bold pop colors, "
                f"empty top-third for title text, high contrast, "
                f"1280x720, clickable composition"
            )
            ssml = self._ssml_for_scene(cfg["narration"], series.target_age)
            scene = Scene(
                number=i,
                title=cfg["title"],
                description=cfg["description"],
                image_prompt=image_prompt,
                thumbnail_prompt=thumbnail_prompt,
                narration_script=cfg["narration"],
                duration_seconds=cfg["duration_seconds"],
                audiobook_ssml=ssml,
                heyjen_visual=cfg.get("heyjen_avatar", "friendly_narrator"),
                heyjen_audio_text=cfg["narration"],
            )
            scenes.append(scene)

        episode = Episode(
            series=series,
            number=number,
            title=title,
            villain=villain,
            problem=problem,
            moral=moral,
            act_one=act_one,
            act_two=act_two,
            act_three=act_three,
            scenes=scenes,
        )
        series.episodes.append(episode)
        return episode

    @staticmethod
    def _ssml_for_scene(narration, target_age):
        """Generate ElevenLabs-compatible SSML for a child's audiobook chapter."""
        return (
            f"<speak>{narration}</speak>"
        )

